<Window x:Class="Polaris.Gps.App.Views.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
        Title="{x:Static res:Strings.ConvertTitle}" Width="640" Height="560" MinWidth="480" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.ConvertStart}" IsDefault="True" Padding="14,3" Margin="0,0,8,0"
                    Command="{Binding ConvertCommand}" />
            <Button Content="{x:Static res:Strings.DialogClose}" IsCancel="True" Padding="14,3" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.ConvertFiles}" Margin="0,0,0,4" />
        <DockPanel DockPanel.Dock="Top" Height="130">
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                <Button Content="{x:Static res:Strings.ConvertAddFiles}" Command="{Binding AddFilesCommand}" Padding="10,2" Margin="0,0,0,6" />
                <Button Content="{x:Static res:Strings.ConvertRemove}" Command="{Binding RemoveFileCommand}" Padding="10,2" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" IsEnabled="{Binding IsIdle}"
                     AutomationProperties.Name="{x:Static res:Strings.A11yConvertFiles}" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
            <TextBlock Text="{x:Static res:Strings.ConvertDestination}" Margin="0,0,0,4" />
            <RadioButton Content="{x:Static res:Strings.ConvertSameFolder}" IsChecked="{Binding UseSourceFolder}" GroupName="Destination" />
            <DockPanel Margin="0,4,0,0">
                <RadioButton DockPanel.Dock="Left" Content="{x:Static res:Strings.ConvertOtherFolder}" IsChecked="{Binding UseOtherFolder}"
                             GroupName="Destination" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.ConvertBrowse}" Command="{Binding BrowseCommand}" Padding="10,2" Margin="8,0,0,0" />
                <TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseOtherFolder}"
                         AutomationProperties.Name="{x:Static res:Strings.A11yConvertFolder}" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="{x:Static res:Strings.ConvertExisting}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="300" ItemsSource="{Binding ExistingOptions}" SelectedItem="{Binding Existing}"
                          AutomationProperties.Name="{x:Static res:Strings.A11yConvertExisting}" />
            </StackPanel>
            <TextBlock Text="{x:Static res:Strings.ConvertNote}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0" Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}}">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.ConvertStop}" Command="{Binding StopCommand}" Padding="10,2" Margin="8,0,0,0" />
            <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                         AutomationProperties.Name="{x:Static res:Strings.ProgressName}" />
        </DockPanel>

        <TextBox Margin="0,10,0,0" Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static res:Strings.A11yConvertReport}" />
    </DockPanel>
</Window>
