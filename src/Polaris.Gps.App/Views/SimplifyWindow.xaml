<Window x:Class="Polaris.Gps.App.Views.SimplifyWindow" Icon="{DynamicResource IconSimplify}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
        Title="{Binding Title}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <DockPanel>
            <TextBlock Text="{x:Static res:Strings.SimplifyTolerance}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ToleranceBox" Width="80" HorizontalAlignment="Left"
                     Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static res:Strings.SimplifyTolerance}" />
        </DockPanel>
        <TextBlock Text="{Binding Preview}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Text="{x:Static res:Strings.SimplifyNote}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{DynamicResource AccentButtonStyle}" Content="{x:Static res:Strings.DialogApply}" IsDefault="True" Padding="14,3" Margin="0,0,8,0"
                    IsEnabled="{Binding CanApply}" Click="OnApply" />
            <Button Content="{x:Static res:Strings.DialogCancel}" IsCancel="True" Padding="14,3" />
        </StackPanel>
    </StackPanel>
</Window>
