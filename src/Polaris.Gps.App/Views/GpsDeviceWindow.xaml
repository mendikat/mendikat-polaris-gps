<Window x:Class="Polaris.Gps.App.Views.GpsDeviceWindow" Icon="{DynamicResource IconConvert}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
        Title="{Binding Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <StackPanel Margin="14">
        <Label Content="{x:Static res:Strings.GpsDevice}" Target="{Binding ElementName=DeviceBox}" Padding="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.GpsRefresh}" Command="{Binding RefreshCommand}" Padding="10,3" Margin="8,0,0,0" />
            <ComboBox x:Name="DeviceBox" ItemsSource="{Binding Devices}" SelectedItem="{Binding Device}"
                      AutomationProperties.Name="{x:Static res:Strings.GpsDevice}" />
        </DockPanel>
        <TextBlock Text="{x:Static res:Strings.GpsNoDevice}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding HasNoDevice, Converter={StaticResource BoolToVisibility}}" />

        <!-- Send: name of the file on the device -->
        <StackPanel Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
            <Label Content="{x:Static res:Strings.GpsFileName}" Target="{Binding ElementName=FileNameBox}" Padding="0,0,0,4" />
            <TextBox x:Name="FileNameBox" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:Strings.GpsFileName}" />
            <TextBlock Text="{Binding Destination}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Receive: the files of the device -->
        <StackPanel Visibility="{Binding IsReceiving, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
            <TextBlock Text="{x:Static res:Strings.GpsFiles}" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding Files}" Height="240" AutomationProperties.Name="{x:Static res:Strings.GpsFiles}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="{x:Static res:Strings.GpsNote}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{DynamicResource AccentButtonStyle}" Content="{Binding AcceptText}" IsDefault="True" Padding="14,3" Margin="0,0,8,0"
                    IsEnabled="{Binding CanAccept}" Click="OnAccept" />
            <Button Content="{x:Static res:Strings.DialogCancel}" IsCancel="True" Padding="14,3" />
        </StackPanel>
    </StackPanel>
</Window>
