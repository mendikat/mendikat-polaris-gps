<UserControl x:Class="Polaris.Gps.App.Views.DocumentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
             xmlns:vm="clr-namespace:Polaris.Gps.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summary -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <Run Text="{Binding FormatLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Counts, Mode=OneWay}" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Warnings}" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat=⚠ {0}}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Layers: name, visibility and selection (LAY-01) -->
        <TextBlock Grid.Row="1" Text="{x:Static res:Strings.PanelLayers}" Style="{StaticResource SectionTitle}" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" MaxHeight="220"
                 AutomationProperties.Name="{x:Static res:Strings.PanelLayers}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LayerItemViewModel}">
                    <DockPanel>
                        <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,6,0"
                                  ToolTip="{x:Static res:Strings.LayerVisibleToolTip}"
                                  AutomationProperties.Name="{x:Static res:Strings.LayerVisibleToolTip}" />
                        <TextBlock Text="{Binding Icon}" Width="18" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            <!-- Segments of a track in parts: click selects its points, ✕ deletes it -->
                            <ItemsControl ItemsSource="{Binding Segments}" Focusable="False" Margin="0,2,0,0"
                                          Visibility="{Binding HasSegments, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SegmentItemViewModel}">
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="✕" Padding="5,0" Margin="6,0,0,0" FontSize="10" MinWidth="0"
                                                    Command="{Binding DataContext.DeleteSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="{x:Static res:Strings.DeleteSegmentToolTip}"
                                                    AutomationProperties.Name="{Binding DeleteName}" />
                                            <TextBlock FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Hyperlink Command="{Binding DataContext.SelectSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" ToolTip="{x:Static res:Strings.SelectSegmentToolTip}">
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Points of the selected layer (LAY-03); several can be selected for deletion -->
        <DockPanel Grid.Row="3">
            <!-- Waypoints: filter by name -->
            <TextBox DockPanel.Dock="Right" Width="170" Margin="8,0,0,4" VerticalAlignment="Center"
                     Text="{Binding WaypointFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     ToolTip="{x:Static res:Strings.WaypointFilterToolTip}" AutomationProperties.Name="{x:Static res:Strings.WaypointFilterToolTip}"
                     Visibility="{Binding IsWaypointLayer, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{x:Static res:Strings.PanelPoints}" Style="{StaticResource SectionTitle}" />
        </DockPanel>
        <DataGrid x:Name="PointsGrid" Grid.Row="4" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionChanged="OnGridSelectionChanged"                  AutomationProperties.Name="{x:Static res:Strings.PanelPoints}">
            <DataGrid.RowStyle>
                <!-- No BasedOn: {x:Type DataGridRow} resolves to the classic style (white rows), not the Fluent one -->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdded}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:Strings.ColNumber}" Binding="{Binding Number}" Width="Auto" />
                <DataGridTextColumn Header="{x:Static res:Strings.ColName}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="{x:Static res:Strings.ColLatitude}" Binding="{Binding Latitude}" Width="Auto" />
                <DataGridTextColumn Header="{x:Static res:Strings.ColLongitude}" Binding="{Binding Longitude}" Width="Auto" />
                <DataGridTextColumn Header="{x:Static res:Strings.ColElevation}" Binding="{Binding Elevation}" Width="Auto" />
                <DataGridTextColumn Header="{x:Static res:Strings.ColTime}" Binding="{Binding Time}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Detail of the selected point (LAY-04, EDIT-04, WPE-02) -->
        <Border Grid.Row="5" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,4,0,0">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.PanelPoint}" Style="{StaticResource SectionTitle}" Margin="0,2,0,4" />
                <TextBlock Text="{Binding SelectionHint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ContentControl Content="{Binding Detail}" Focusable="False">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:PointDetailViewModel}">
                            <Grid>
                                <Grid.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding DataContext.ApplyPointCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <KeyBinding Key="Escape" Command="{Binding DataContext.RevertPointCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{x:Static res:Strings.FieldName}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                         AutomationProperties.Name="{x:Static res:Strings.FieldName}" />

                                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.FieldComment}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                         AutomationProperties.Name="{x:Static res:Strings.FieldComment}" />

                                <TextBlock Grid.Row="2" Text="{x:Static res:Strings.FieldDescription}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                         AutomationProperties.Name="{x:Static res:Strings.FieldDescription}" />
                                <!-- Waypoints only: their symbol -->
                                <TextBlock Grid.Row="3" Text="{x:Static res:Strings.FieldSymbolPlain}" Style="{StaticResource FieldLabel}"
                                           Visibility="{Binding IsWaypoint, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Symbols}" SelectedItem="{Binding Symbol}" Margin="0,2"
                                          Visibility="{Binding IsWaypoint, Converter={StaticResource BoolToVisibility}}"
                                          AutomationProperties.Name="{x:Static res:Strings.FieldSymbolName}" />

                                <TextBlock Grid.Row="4" Text="{x:Static res:Strings.FieldLatitude}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                         AutomationProperties.Name="{x:Static res:Strings.FieldLatitude}" />

                                <TextBlock Grid.Row="5" Text="{x:Static res:Strings.FieldLongitude}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                         AutomationProperties.Name="{x:Static res:Strings.FieldLongitude}" />

                                <TextBlock Grid.Row="6" Text="{x:Static res:Strings.FieldElevation}" Style="{StaticResource FieldLabel}" />
                                <!-- Elevation with its origin in this session: file, interpolated, DEM or typed (DEM-06) -->
                                <DockPanel Grid.Row="6" Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElevationOrigin}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               ToolTip="{x:Static res:Strings.FieldElevationSource}" AutomationProperties.Name="{x:Static res:Strings.FieldElevationSource}" />
                                    <TextBox Text="{Binding Elevation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                             AutomationProperties.Name="{x:Static res:Strings.FieldElevation}" />
                                </DockPanel>

                                <TextBlock Grid.Row="7" Text="{x:Static res:Strings.FieldTimeUtc}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding TimeUtc, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                         ToolTip="{x:Static res:Strings.FieldTimeUtcHint}" AutomationProperties.Name="{x:Static res:Strings.FieldTimeUtc}" />

                                <TextBlock Grid.Row="8" Text="{x:Static res:Strings.FieldTimeLocal}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LocalTime}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="9" Text="{x:Static res:Strings.FieldOther}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding OtherFields}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2" />

                                <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Text="{x:Static res:Strings.FieldAdded}" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}" />

                                <DockPanel Grid.Row="11" Grid.ColumnSpan="2" Margin="0,6,0,0" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.ApplyButton}" Padding="12,2" Margin="6,0,0,0"
                                            Command="{Binding DataContext.ApplyPointCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.RevertButton}" Padding="12,2"
                                            Command="{Binding DataContext.RevertPointCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
