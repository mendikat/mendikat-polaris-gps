<Window x:Class="Polaris.Gps.App.Views.WaypointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
        Title="{Binding Title}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=NameBox}"
        Icon="{DynamicResource IconWaypoint}">
    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="{x:Static res:Strings.FieldName}" Target="{Binding ElementName=NameBox}" Margin="0,0,8,6" Padding="0,2" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                     AutomationProperties.Name="{x:Static res:Strings.FieldName}" />
            <Label Grid.Row="1" Content="{x:Static res:Strings.FieldComment}" Target="{Binding ElementName=CommentBox}" Margin="0,0,8,6" Padding="0,2" />
            <TextBox x:Name="CommentBox" Grid.Row="1" Grid.Column="1" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                     AutomationProperties.Name="{x:Static res:Strings.FieldComment}" />
            <Label Grid.Row="2" Content="{x:Static res:Strings.FieldDescription}" Target="{Binding ElementName=DescriptionBox}" Margin="0,0,8,6" Padding="0,2" />
            <TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                     TextWrapping="Wrap" AcceptsReturn="True" MinLines="3" MaxLines="6" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="{x:Static res:Strings.FieldDescription}" />
            <Label Grid.Row="3" Content="{x:Static res:Strings.FieldSymbol}" Target="{Binding ElementName=SymbolBox}" Margin="0,0,8,6" Padding="0,2" />
            <ComboBox x:Name="SymbolBox" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Symbols}" SelectedItem="{Binding Symbol}" Margin="0,0,0,6"
                      AutomationProperties.Name="{x:Static res:Strings.FieldSymbolName}" />
            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.WaypointPosition}" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Position}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{DynamicResource AccentButtonStyle}" Content="{x:Static res:Strings.SettingsAccept}" IsDefault="True" Padding="14,3" Margin="0,0,8,0" Click="OnAccept" />
            <Button Content="{x:Static res:Strings.DialogCancel}" IsCancel="True" Padding="14,3" />
        </StackPanel>
    </StackPanel>
</Window>
