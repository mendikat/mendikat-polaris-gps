<Window x:Class="Polaris.Gps.App.Views.EcwLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
        Title="{x:Static res:Strings.EcwLicenseTitle}" Width="640" Height="560" MinWidth="460" MinHeight="380"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- ERDAS ECW/JP2 Desktop Read-Only Redistributable SDK, Appendix A: the end user must accept these terms before ECW is used. -->
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.EcwLicenseIntro}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.EcwLicenseAccept}" Padding="14,3" Margin="0,0,8,0" Click="OnAccept" />
            <Button Content="{x:Static res:Strings.EcwLicenseDecline}" IsCancel="True" IsDefault="True" Padding="14,3" />
        </StackPanel>
        <TextBox Text="{x:Static res:Strings.EcwLicenseTerms}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static res:Strings.EcwLicenseTitle}" />
    </DockPanel>
</Window>
