<Window x:Class="Polaris.Gps.App.Views.CleanWindow" Icon="{DynamicResource IconSimplify}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
        xmlns:local="clr-namespace:Polaris.Gps.App"
        Title="{Binding Title}" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Window.Resources>
    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CheckBox x:Name="FirstOption" Content="{x:Static res:Strings.CleanJumps}" IsChecked="{Binding RemoveJumps}" IsEnabled="{Binding HasTimes}"
                      VerticalAlignment="Center" Margin="0,4" />
            <TextBox Grid.Column="1" Text="{Binding MaxSpeedText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RemoveJumps}"
                     AutomationProperties.Name="{x:Static res:Strings.CleanJumps}" Margin="0,4" />
            <TextBlock Grid.Column="2" Text="km/h" VerticalAlignment="Center" Margin="6,0,0,0" />

            <CheckBox Grid.Row="1" Content="{x:Static res:Strings.CleanSpikes}" IsChecked="{Binding RemoveSpikes}" VerticalAlignment="Center" Margin="0,4" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SpikeText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RemoveSpikes}"
                     AutomationProperties.Name="{x:Static res:Strings.CleanSpikes}" Margin="0,4" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="6,0,0,0" />

            <CheckBox Grid.Row="2" Content="{x:Static res:Strings.CleanStops}" IsChecked="{Binding RemoveStops}" VerticalAlignment="Center" Margin="0,4" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StopRadiusText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RemoveStops}"
                     AutomationProperties.Name="{x:Static res:Strings.CleanStops}" Margin="0,4" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="6,0,0,0" />

            <CheckBox Grid.Row="3" Content="{x:Static res:Strings.CleanSmooth}" IsChecked="{Binding SmoothElevation}"
                      IsEnabled="{Binding HasElevations}" VerticalAlignment="Center" Margin="0,4" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SmoothWindowText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SmoothElevation}"
                     AutomationProperties.Name="{x:Static res:Strings.CleanSmooth}" ToolTip="{x:Static res:Strings.CleanSmoothToolTip}" Margin="0,4" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="6,0,0,0" />
        </Grid>
        <TextBlock Text="{x:Static res:Strings.CleanNoTimes}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasTimes, Converter={StaticResource InverseBoolToVisibility}}" />
        <TextBlock Text="{Binding Preview}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Text="{x:Static res:Strings.CleanNote}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{DynamicResource AccentButtonStyle}" Content="{x:Static res:Strings.DialogApply}" IsDefault="True" Padding="14,3" Margin="0,0,8,0"
                    IsEnabled="{Binding CanApply}" Click="OnApply" />
            <Button Content="{x:Static res:Strings.DialogCancel}" IsCancel="True" Padding="14,3" />
        </StackPanel>
    </StackPanel>
</Window>
