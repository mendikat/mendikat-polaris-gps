<Window x:Class="Polaris.Gps.App.Views.DemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
        Title="{Binding Title}" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <StackPanel Margin="14">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static res:Strings.DemResolution}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="200" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}"
                      IsEnabled="{Binding CanChangeResolution}" AutomationProperties.Name="{x:Static res:Strings.DemResolution}" />
            <Button Content="{x:Static res:Strings.DemQuery}" Command="{Binding QueryCommand}" Padding="12,2" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding SourceInfo}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,8,0,0" />

        <DockPanel Margin="0,10,0,0" Visibility="{Binding IsQuerying, Converter={StaticResource BoolToVisibility}}">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.DemStop}" Command="{Binding CancelQueryCommand}" Padding="10,2" Margin="8,0,0,0" />
            <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                         AutomationProperties.Name="{x:Static res:Strings.ProgressName}" />
        </DockPanel>

        <Border BorderBrush="LightGray" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Error}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{x:Static res:Strings.DemNote}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static res:Strings.DialogApply}" IsDefault="True" Padding="14,3" Margin="0,0,8,0"
                    IsEnabled="{Binding CanApply}" Click="OnApply" />
            <Button Content="{x:Static res:Strings.DialogCancel}" IsCancel="True" Padding="14,3" />
        </StackPanel>
    </StackPanel>
</Window>
