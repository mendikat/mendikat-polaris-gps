<Window x:Class="Polaris.Gps.App.Views.TimesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
        Title="{Binding Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,10,3" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static res:Strings.TimesStartDate}" Style="{StaticResource Label}" />
            <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" Width="160" HorizontalAlignment="Left" Margin="0,3"
                        AutomationProperties.Name="{x:Static res:Strings.TimesStartDate}" />
            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.TimesStartTime}" Style="{StaticResource Label}" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,3"
                     Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static res:Strings.TimesStartTime}" />
            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.TimesTimeZone}" Style="{StaticResource Label}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" ItemsSource="{Binding TimeZones}" SelectedItem="{Binding TimeZone}"
                      DisplayMemberPath="DisplayName" AutomationProperties.Name="{x:Static res:Strings.TimesTimeZone}" />
        </Grid>

        <RadioButton Content="{x:Static res:Strings.TimesModeDistance}" IsChecked="{Binding ByDistance}" Margin="0,12,0,4" GroupName="Mode" />
        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" IsEnabled="{Binding ByDistance}">
            <TextBlock Text="{x:Static res:Strings.TimesSpeed}" Style="{StaticResource Label}" />
            <TextBox Width="70" Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,6,3"
                     AutomationProperties.Name="{x:Static res:Strings.TimesSpeed}" />
            <ComboBox Width="130" ItemsSource="{Binding SpeedUnits}" SelectedItem="{Binding SelectedSpeedUnit}" Margin="0,3"
                      AutomationProperties.Name="{x:Static res:Strings.A11ySpeedUnitName}" />
        </StackPanel>
        <CheckBox Content="{x:Static res:Strings.TimesIncludeGaps}" IsChecked="{Binding IncludeSegmentGaps}" Margin="22,4,0,0"
                  IsEnabled="{Binding ByDistance}" Visibility="{Binding HasSeveralSegments, Converter={StaticResource BoolToVisibility}}" />

        <RadioButton Content="{x:Static res:Strings.TimesModeUniform}" IsChecked="{Binding Uniform}" Margin="0,10,0,4" GroupName="Mode" />
        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" IsEnabled="{Binding Uniform}">
            <TextBlock Text="{x:Static res:Strings.TimesInterval}" Style="{StaticResource Label}" />
            <TextBox Width="70" Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"
                     AutomationProperties.Name="{x:Static res:Strings.TimesInterval}" />
        </StackPanel>

        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{x:Static res:Strings.TimesNote}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static res:Strings.DialogApply}" IsDefault="True" Padding="14,3" Margin="0,0,8,0"
                    IsEnabled="{Binding CanApply}" Click="OnApply" />
            <Button Content="{x:Static res:Strings.DialogCancel}" IsCancel="True" Padding="14,3" />
        </StackPanel>
    </StackPanel>
</Window>
