<Window x:Class="Polaris.Gps.App.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Polaris.Gps.App"
        xmlns:res="clr-namespace:Polaris.Gps.App.Resources"
        xmlns:vm="clr-namespace:Polaris.Gps.App.ViewModels"
        xmlns:charting="clr-namespace:Polaris.Gps.App.Charting"
        Title="{Binding Title}" Width="1000" Height="480" MinWidth="460" MinHeight="380"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <!-- Icons of the summary figures, 24 × 24 -->
        <Geometry x:Key="IconDistance">M2,12 L7,6.5 L7,10.5 L17,10.5 L17,6.5 L22,12 L17,17.5 L17,13.5 L7,13.5 L7,17.5 Z M2,3 L4,3 L4,21 L2,21 Z M20,3 L22,3 L22,21 L20,21 Z</Geometry>
        <Geometry x:Key="IconAscent">M2,19 L9,12 L13,16 L19.2,9.8 L16,9.8 L16,7 L22,7 L22,13 L19.2,13 L19.2,12.6 L13,18.8 L9,14.8 L4,19.8 Z</Geometry>
        <Geometry x:Key="IconDescent">M2,5 L9,12 L13,8 L19.2,14.2 L16,14.2 L16,17 L22,17 L22,11 L19.2,11 L19.2,11.4 L13,5.2 L9,9.2 L4,4.2 Z</Geometry>
        <Geometry x:Key="IconMaxElevation">M1,21 L9,8 L12.5,13.5 L15.5,9.5 L23,21 Z M9,1 L13,5.5 L10,5.5 L10,7 L8,7 L8,5.5 L5,5.5 Z</Geometry>
        <Geometry x:Key="IconMinElevation">M1,6 L6,6 L12,15 L18,6 L23,6 L23,21 L1,21 Z M12,1 L15.5,5 L13,5 L13,10 L11,10 L11,5 L8.5,5 Z</Geometry>
        <Geometry x:Key="IconTotalTime">M12,1.5 A10.5,10.5 0 1 1 11.99,1.5 Z M12,4 A8,8 0 1 0 12.01,4 Z M11,6 L13,6 L13,11.4 L16.8,13.6 L15.8,15.3 L11,12.6 Z</Geometry>
        <Geometry x:Key="IconMovingTime">M14.5,1.5 A2.2,2.2 0 1 1 14.49,1.5 Z M12,6.4 L15.2,7.4 L17.6,11 L15.9,12.1 L14.3,9.7 L13.5,13.2 L16.4,16.2 L16.4,22 L14.2,22 L14.2,17.2 L11.6,14.9 L10.6,18.3 L6.9,22 L5.3,20.5 L8.6,17.2 L10.7,8.9 L9.3,9.7 L8.3,13.2 L6.2,12.6 L7.5,8.1 Z</Geometry>
        <Geometry x:Key="IconStoppedTime">M12,1.5 A10.5,10.5 0 1 1 11.99,1.5 Z M8.5,7 L8.5,17 L11,17 L11,7 Z M13,7 L13,17 L15.5,17 L15.5,7 Z</Geometry>
        <Geometry x:Key="IconAverageSpeed">M1.5,18 A10.5,10.5 0 0 1 22.5,18 L20,18 A8,8 0 0 0 4,18 Z M12,15.5 A2.5,2.5 0 1 1 11.99,15.5 Z M11,17.6 L10.4,9 L13,17.4 Z</Geometry>
        <Geometry x:Key="IconMaxSpeed">M1.5,18 A10.5,10.5 0 0 1 22.5,18 L20,18 A8,8 0 0 0 4,18 Z M12,15.5 A2.5,2.5 0 1 1 11.99,15.5 Z M11.4,16.4 L19.5,11.5 L12.6,19 Z</Geometry>

        <!-- One figure: icon, value and label (PROF-02, PROF-06, PROF-07) -->
        <DataTemplate x:Key="StatTile" DataType="{x:Type vm:ProfileStat}">
            <Border Background="#F3F5F8" BorderBrush="#E1E5EB" BorderThickness="1" CornerRadius="6"
                    Padding="8,5,12,5" Margin="0,0,6,6"
                    AutomationProperties.Name="{Binding Description}" Focusable="True">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="Icon" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"
                          Margin="0,0,8,0" Fill="#34495E" Data="{StaticResource IconDistance}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2933" />
                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#5F6B7A" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.Distance}">
                    <Setter TargetName="Icon" Property="Fill" Value="#1F5FBF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.Ascent}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconAscent}" />
                    <Setter TargetName="Icon" Property="Fill" Value="#2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.Descent}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconDescent}" />
                    <Setter TargetName="Icon" Property="Fill" Value="#C0392B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.MinElevation}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconMinElevation}" />
                    <Setter TargetName="Icon" Property="Fill" Value="#2C7A9B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.MaxElevation}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconMaxElevation}" />
                    <Setter TargetName="Icon" Property="Fill" Value="#8D5A2B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.TotalTime}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconTotalTime}" />
                    <Setter TargetName="Icon" Property="Fill" Value="#34495E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.MovingTime}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconMovingTime}" />
                    <Setter TargetName="Icon" Property="Fill" Value="#2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.StoppedTime}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconStoppedTime}" />
                    <Setter TargetName="Icon" Property="Fill" Value="#D9822B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.AverageSpeed}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconAverageSpeed}" />
                    <Setter TargetName="Icon" Property="Fill" Value="#6A4C93" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ProfileStatKind.MaxSpeed}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconMaxSpeed}" />
                    <Setter TargetName="Icon" Property="Fill" Value="#C0392B" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TileRow">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5F6B7A" />
            <Setter Property="Margin" Value="2,0,0,3" />
        </Style>
    </Window.Resources>
    <!-- Title bar icon: a track (a winding line from a green start to a red end) -->
    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 L32,0 L32,32 L0,32 Z" />
                    <GeometryDrawing Geometry="M6,26 C10,17 15,25 17,16 S25,12 26,6">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#DC143C" Thickness="3.5" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2E7D32" Geometry="M6,22.5 A3.5,3.5 0 1 1 5.99,22.5 Z">
                        <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.2" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8B0000" Geometry="M26,2.5 A3.5,3.5 0 1 1 25.99,2.5 Z">
                        <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.2" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>
    <DockPanel>
        <!-- Summary: a row of route figures and a row of time figures; tiles wrap on narrow windows -->
        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,2">
            <StackPanel ToolTip="{x:Static res:Strings.ProfileStatsHint}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.StatGroupRoute}" Style="{StaticResource GroupTitle}" />
                    <ItemsControl ItemsSource="{Binding RouteStats}" ItemTemplate="{StaticResource StatTile}"
                                  ItemsPanel="{StaticResource TileRow}" Focusable="False"
                                  AutomationProperties.Name="{x:Static res:Strings.StatGroupRoute}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.StatGroupTime}" Style="{StaticResource GroupTitle}" />
                    <ItemsControl ItemsSource="{Binding TimeStats}" ItemTemplate="{StaticResource StatTile}"
                                  ItemsPanel="{StaticResource TileRow}" Focusable="False"
                                  AutomationProperties.Name="{x:Static res:Strings.StatGroupTime}" />
                    <TextBlock Text="{Binding NoTimesNote}" FontSize="11" Foreground="#5F6B7A" Margin="2,0,0,6"
                               Visibility="{Binding NoTimesNote, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="10,0,10,4" Text="{Binding MissingWarning}" Foreground="DarkGoldenrod" TextWrapping="Wrap"
                   Visibility="{Binding HasMissingWarning, Converter={StaticResource BoolToVisibility}}" />

        <!-- Readout of the point under the pointer (PROF-04) and the segment gap option (PROF-02) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Content="{x:Static res:Strings.ProfileIncludeGaps}" Margin="12,0,0,0"
                          IsChecked="{Binding IncludeSegmentGaps}" VerticalAlignment="Center"
                          Visibility="{Binding HasSeveralSegments, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding HoverText}" Foreground="DimGray" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <charting:ProfileChart x:Name="Chart" Margin="4"
                               Profile="{Binding Profile}"
                               CursorDistance="{Binding CursorDistance}"
                               HoverDistance="{Binding HoverDistance}"
                               AutomationProperties.Name="{x:Static res:Strings.MenuElevationProfile}" />
    </DockPanel>
</Window>
