<!-- ThemeMode: WPF's built-in Windows 11 (Fluent) theme, light or dark as Windows is set, including the title bar.
     Views use its brushes (DynamicResource TextFillColorSecondaryBrush, SystemFillColorCriticalBrush...) instead of
     fixed colours, so they follow the theme; only what sits over the map keeps fixed light colours. The main button
     of each dialog uses its AccentButtonStyle (the Windows accent colour). -->
<Application x:Class="Polaris.Gps.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose" ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/WindowIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
