<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 (Windows 10 2004+) is required by SkiaSharp.Views.WPF, used by Mapsui.Wpf. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Mendikat.TrailLab</AssemblyName>
    <RootNamespace>Mendikat.TrailLab.App</RootNamespace>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Mapsui.Wpf" Version="5.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mendikat.TrailLab.Domain\Mendikat.TrailLab.Domain.csproj" />
    <ProjectReference Include="..\Mendikat.TrailLab.Gpx\Mendikat.TrailLab.Gpx.csproj" />
    <ProjectReference Include="..\Mendikat.TrailLab.Mapping\Mendikat.TrailLab.Mapping.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mendikat.TrailLab.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- ApplicationIcon only sets the .exe icon. The window icon (Icon="Assets/icon.ico" in MainWindow.xaml)
         is loaded at run time from the assembly resources, so the file must be a WPF Resource too. -->
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- UI texts (Spanish). The strongly typed class is generated into obj/ at build time. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Mendikat.TrailLab.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
  <!-- WPF compiles XAML in a temporary project before resources are generated; generate the
       strongly typed Strings class first so both XAML and code can use it. -->
  <Target Name="GenerateStringsBeforeMarkup" BeforeTargets="MarkupCompilePass1" DependsOnTargets="PrepareResourceNames;ResGen">
    <ItemGroup>
      <_GeneratedCodeFiles Include="$(IntermediateOutputPath)Strings.Designer.cs" />
    </ItemGroup>
  </Target>
</Project>
