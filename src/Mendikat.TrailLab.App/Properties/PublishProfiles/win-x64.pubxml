<?xml version="1.0" encoding="utf-8"?>
<!-- Framework-dependent distribution (decision of increment 8, ADR-0001): users install the
     .NET 10 Desktop Runtime once; the folder holds only the application and its libraries.
     Usage, from the repository root: dotnet publish src\Mendikat.TrailLab.App -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
