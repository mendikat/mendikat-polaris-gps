<Window x:Class="Mendikat.TrailLab.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mendikat.TrailLab.App.Resources"
        Title="{x:Static res:Strings.AboutTitle}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Mendikat.TrailLab;component/Assets/icon.ico">
    <StackPanel Margin="20,18,20,16">
        <DockPanel>
            <Image Source="pack://application:,,,/Mendikat.TrailLab;component/Assets/icon.png" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Top"
                   AutomationProperties.Name="{Binding ProductName}" />
            <StackPanel>
                <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionText}" Foreground="#5F6B7A" Margin="0,2,0,0" />
                <TextBlock Text="{x:Static res:Strings.AboutDescription}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Margin="80,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="2" Text="{Binding AuthorText}" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.AboutEmailLabel}" Margin="0,0,8,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                <Hyperlink NavigateUri="{Binding AuthorEmailUri}" RequestNavigate="OnNavigate"
                           AutomationProperties.Name="{Binding AuthorEmailText}">
                    <Run Text="{Binding AuthorEmailText, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.AboutWebLabel}" Margin="0,0,8,0" />
            <TextBlock Grid.Row="2" Grid.Column="1">
                <Hyperlink NavigateUri="{Binding Web}" RequestNavigate="OnNavigate"
                           AutomationProperties.Name="{Binding WebText}">
                    <Run Text="{Binding WebText, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </Grid>

        <!-- Donation, as on mendikat.net -->
        <Border Background="#FFF8E1" BorderBrush="#F0D58A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.AboutDonateButton}" Click="OnDonate"
                        Padding="14,5" FontWeight="SemiBold" Background="#FFC107" BorderBrush="#E0A800" VerticalAlignment="Center"
                        ToolTip="{x:Static res:Strings.AboutDonateToolTip}" Margin="12,0,0,0" />
                <TextBlock Text="{x:Static res:Strings.AboutDonateHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Required by the ERDAS ECW/JP2 Desktop Read-Only Redistributable SDK licence (section 3.4). -->
        <TextBlock Text="{x:Static res:Strings.AboutEcwNotice}" TextWrapping="Wrap" FontSize="10" Foreground="#5F6B7A" Margin="0,12,0,0" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.DialogClose}" IsCancel="True" IsDefault="True" Padding="18,3" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.AboutCheckUpdates}" Click="OnCheckUpdates" Padding="12,3" Margin="0,0,8,0" />
        </DockPanel>
    </StackPanel>
</Window>
