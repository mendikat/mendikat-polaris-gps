<Window x:Class="Mendikat.TrailLab.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mendikat.TrailLab.App.Resources"
        xmlns:views="clr-namespace:Mendikat.TrailLab.App.Views"
        Title="{x:Static res:Strings.SettingsTitle}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=LanguageBox}">
    <Window.Resources>
        <views:LanguageFlagConverter x:Key="Flag" />
    </Window.Resources>
    <StackPanel Margin="14">
        <GroupBox Header="{x:Static res:Strings.SettingsGeneral}" Padding="8">
            <StackPanel>
                <Label Content="{x:Static res:Strings.SettingsLanguage}" Target="{Binding ElementName=LanguageBox}" Padding="0,0,0,4" />
                <ComboBox x:Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                          AutomationProperties.Name="{x:Static res:Strings.SettingsLanguageName}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Code, Converter={StaticResource Flag}}" Width="24" Height="16" Margin="0,1,8,1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding NativeName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{x:Static res:Strings.SettingsLanguageRestart}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static res:Strings.SettingsAccept}" IsDefault="True" Padding="14,3" Margin="0,0,8,0" Click="OnAccept" />
            <Button Content="{x:Static res:Strings.DialogCancel}" IsCancel="True" Padding="14,3" />
        </StackPanel>
    </StackPanel>
</Window>
