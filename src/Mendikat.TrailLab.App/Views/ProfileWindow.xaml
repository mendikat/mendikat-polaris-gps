<Window x:Class="Mendikat.TrailLab.App.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Mendikat.TrailLab.App.Resources"
        xmlns:charting="clr-namespace:Mendikat.TrailLab.App.Charting"
        Title="{Binding Title}" Width="900" Height="360" MinWidth="400" MinHeight="220"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel>
        <!-- Summary and options -->
        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" VerticalAlignment="Center" />
            <CheckBox DockPanel.Dock="Right" Content="{x:Static res:Strings.ProfileIncludeGaps}"
                      IsChecked="{Binding IncludeSegmentGaps}" VerticalAlignment="Center"
                      Visibility="{Binding HasSeveralSegments, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="10,0,10,4" Text="{Binding MissingWarning}" Foreground="DarkGoldenrod" TextWrapping="Wrap"
                   Visibility="{Binding HasMissingWarning, Converter={StaticResource BoolToVisibility}}" />

        <!-- Readout of the point under the pointer (PROF-04) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Text="{Binding HoverText}" Foreground="DimGray" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <charting:ProfileChart x:Name="Chart" Margin="4"
                               Profile="{Binding Profile}"
                               CursorDistance="{Binding CursorDistance}"
                               HoverDistance="{Binding HoverDistance}"
                               AutomationProperties.Name="{x:Static res:Strings.MenuElevationProfile}" />
    </DockPanel>
</Window>
