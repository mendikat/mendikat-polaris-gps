<Window x:Class="Mendikat.TrailLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mendikat.TrailLab.App"
        xmlns:res="clr-namespace:Mendikat.TrailLab.App.Resources"
        xmlns:vm="clr-namespace:Mendikat.TrailLab.App.ViewModels"
        xmlns:views="clr-namespace:Mendikat.TrailLab.App.Views"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="{Binding Title}"
        Width="1280" Height="820" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewGpxCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenGpxCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseDocumentCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="Insert" Command="{Binding InsertPointCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Classic top menu (APP-02) -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static res:Strings.MenuFile}">
                <MenuItem Header="{x:Static res:Strings.MenuNewGpx}" Command="{Binding NewGpxCommand}" InputGestureText="Ctrl+N" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuOpenGpx}" Command="{Binding OpenGpxCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="{x:Static res:Strings.MenuOpenWpt}" Command="{Binding OpenWptCommand}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuSave}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="{x:Static res:Strings.MenuSaveAs}" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuCloseDocument}" Command="{Binding CloseDocumentCommand}" InputGestureText="Ctrl+F4" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuExit}" Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuEdit}">
                <MenuItem Header="{x:Static res:Strings.MenuUndo}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{x:Static res:Strings.MenuRedo}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuDelete}" Command="{Binding DeleteCommand}" InputGestureText="Supr" />
                <MenuItem Header="{x:Static res:Strings.MenuInsertPoint}" Command="{Binding InsertPointCommand}" InputGestureText="Insert" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuTools}">
                <MenuItem Header="{x:Static res:Strings.MenuSimplify}" Command="{Binding SimplifyCommand}" />
                <MenuItem Header="{x:Static res:Strings.MenuRegenerateTimes}" Command="{Binding RegenerateTimesCommand}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuAdjustElevations}" Command="{Binding AdjustElevationsCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuView}">
                <MenuItem Header="{x:Static res:Strings.MenuZoomIn}" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="{x:Static res:Strings.MenuZoomOut}" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="{x:Static res:Strings.MenuZoomToData}" Command="{Binding ZoomToDataCommand}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuElevationProfile}" Command="{Binding ElevationProfileCommand}" />
            </MenuItem>
        </Menu>

        <!-- Map controls (APP-06) -->
        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <Button Content="+" Width="28" FontWeight="Bold" Command="{Binding ZoomInCommand}"
                    ToolTip="{x:Static res:Strings.ToolZoomIn}" AutomationProperties.Name="{x:Static res:Strings.MenuZoomIn}" />
            <Button Content="−" Width="28" FontWeight="Bold" Command="{Binding ZoomOutCommand}"
                    ToolTip="{x:Static res:Strings.ToolZoomOut}" AutomationProperties.Name="{x:Static res:Strings.MenuZoomOut}" />
            <Button Content="⤢" Width="28" Command="{Binding ZoomToDataCommand}"
                    ToolTip="{x:Static res:Strings.ToolZoomToData}" AutomationProperties.Name="{x:Static res:Strings.MenuZoomToData}" />
            <Separator />
            <TextBlock Text="{x:Static res:Strings.ToolMapProvider}" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Width="220" ItemsSource="{Binding MapProviders}" SelectedItem="{Binding SelectedMapProvider}"
                      DisplayMemberPath="DisplayName" AutomationProperties.Name="{x:Static res:Strings.ToolMapProvider}" />
            <Separator />
            <!-- ToolTip shown even when disabled: the button explains when it becomes available. -->
            <Button Content="{x:Static res:Strings.ToolProfileButton}" Command="{Binding ElevationProfileCommand}"
                    ToolTip="{x:Static res:Strings.ToolElevationProfile}" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="{x:Static res:Strings.MenuElevationProfile}" />
        </ToolBar>

        <!-- Status bar: messages, cartography problems and pointer coordinates (COORD-01/02, MAP-07) -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Width="260" ToolTip="WGS84, grados minutos segundos">
                <TextBlock Text="{Binding PointerDms}" AutomationProperties.Name="Coordenadas geográficas WGS84" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right" Width="190" ToolTip="UTM WGS84: zona y banda, Este, Norte (m)">
                <TextBlock Text="{Binding PointerUtm}" AutomationProperties.Name="Coordenadas UTM" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="80" Height="12" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding MapStatus, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding MapStatus}" Foreground="DarkRed" AutomationProperties.Name="Estado de la cartografía" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Estado" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Documents: one tab per open file (APP-03, ADR-0002) -->
            <TabControl Grid.Column="0" ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                        Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding FileName}">
                            <Rectangle Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding ColorHex}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                            <Button Content="✕" Margin="6,0,0,0" Padding="4,0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Focusable="False"
                                    ToolTip="{x:Static res:Strings.CloseTabToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.CloseTabToolTip}"
                                    Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                        <views:DocumentPanel />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.NoDocumentsHint}" Margin="16"
                       TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" Foreground="Gray"
                       Visibility="{Binding HasDocuments, Converter={StaticResource InverseBoolToVisibility}}" />

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- Shared map with the layers of all documents (MAP-01) -->
            <Grid Grid.Column="2">
                <mapsui:MapControl x:Name="MapView">
                    <mapsui:MapControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Strings.MenuDelete}" Command="{Binding DeleteCommand}" InputGestureText="Supr" />
                            <MenuItem Header="{x:Static res:Strings.MenuInsertPoint}" Command="{Binding InsertPointCommand}" InputGestureText="Insert" />
                        </ContextMenu>
                    </mapsui:MapControl.ContextMenu>
                </mapsui:MapControl>
                <!-- Mandatory attribution of the active provider (MAP-06) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#C8FFFFFF" Padding="6,2" MaxWidth="600">
                    <TextBlock FontSize="11" TextWrapping="Wrap">
                        <Hyperlink NavigateUri="{Binding SelectedMapProvider.AttributionUrl}" RequestNavigate="OnAttributionNavigate">
                            <Run Text="{Binding SelectedMapProvider.AttributionText, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>